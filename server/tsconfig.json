{
  "compilerOptions": {
    "target": "es2025",
    "module": "esnext",
    "outDir": "./build",
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "moduleDetection": "force",
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}